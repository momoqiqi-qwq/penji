/* components/profileSheet/profileSheet.wxss —— 底部上滑的个人信息卡 */
.ps-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
  background: rgba(11, 31, 22, 0.45);
}

.ps-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  box-shadow: var(--sh-2);
  animation: ps-up 200ms ease-out;
}

@keyframes ps-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* ---------------- 头：头像 + 昵称 + 身份 ---------------- */
.ps-head {
  display: flex;
  align-items: center;
}

.ps-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border-radius: 50%;
  background: var(--green-light);
}

.ps-avatar-img {
  width: 104rpx;
  height: 104rpx;
}

.ps-avatar-tx {
  font-size: 32rpx;
  color: var(--green);
}

.ps-id {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.ps-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ps-role {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 0.04em;
}

/* ---------------- 明细 ---------------- */
.ps-rows {
  margin-top: 32rpx;
}

.ps-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}

.ps-k {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-2);
}

.ps-v {
  margin-left: 32rpx;
  font-size: 24rpx;
  text-align: right;
  color: var(--text);
  word-break: break-all;
}

.ps-hint {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.ps-close {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--green);
  border-radius: var(--r-md);
  box-shadow: var(--sh-btn);
}

.ps-close::after {
  border: none;
}
