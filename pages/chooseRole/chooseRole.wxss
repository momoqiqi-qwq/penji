/* pages/chooseRole/chooseRole.wxss —— 进入界面：深色头图 + 白卡上浮 */
.auth {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* ---------------- 头图 ---------------- */
.auth-hero {
  position: relative;
  overflow: hidden;
  /* 竖向 padding 交给导航栏和 logo 自己撑，顶上空出来的就是状态栏 + 导航栏 */
  padding: 0 44rpx 148rpx;
  text-align: center;
  background:
    radial-gradient(120% 80% at 82% -18%, rgba(53, 160, 106, 0.5) 0%, rgba(53, 160, 106, 0) 62%),
    linear-gradient(168deg, #0A2318 0%, #0E3524 58%, #0A2819 100%);
}
/* 田垄斜线：低透明度，只做质感 */
.auth-hero::after {
  content: "";
  position: absolute;
  left: -14%;
  right: -14%;
  bottom: -34%;
  height: 82%;
  background: repeating-linear-gradient(
    170deg,
    rgba(207, 235, 200, 0.1) 0,
    rgba(207, 235, 200, 0.1) 1rpx,
    transparent 1rpx,
    transparent 34rpx
  );
  transform: rotate(-5deg);
  pointer-events: none;
}
/* ---------------- 自定义导航栏 ----------------
   这一页要一条原生栏里放不下的东西（房子 + 头像），所以整条自己画。
   底部与头图同底：渐变从导航栏后面就已经开始，接缝看不出来 */
.nav {
  position: relative;
  z-index: 3;
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
}

.nav-left {
  display: flex;
  align-items: center;
}

/* 回首页：半透明圆底 + 白色房子线框，和微信原生那颗保持同一个手感 */
.nav-home {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(244, 248, 239, 0.12);
}

.nav-home-ic {
  width: 34rpx;
  height: 34rpx;
}

/* 头像紧挨着房子：它就是「这是谁」的入口，点开看个人信息 */
.nav-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: 24rpx;
  border-radius: 50%;
}

.nav-avatar-img {
  display: block;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(244, 248, 239, 0.5);
}

.nav-avatar-tx {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--green-light);
  font-size: 24rpx;
  color: var(--green);
}

/* 青柠小点 = 微信身份已核验；没核验就不亮 */
.nav-avatar-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2rpx solid #0A2318;
  background: var(--lime);
}

/* 标题压正中，不吃点击（左右两簇才是可点的） */
.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #F4F8EF;
  pointer-events: none;
}

.nav-press {
  opacity: 0.65;
}

/* 徽标：整块头图里唯一的图形锚点，居中，尺寸取「棚迹」两字宽度的六成 */
.auth-logo {
  display: block;
  width: 128rpx;
  height: 128rpx;
  margin: 72rpx auto 24rpx;
}
/* 下面三行的 padding-left 与各自的 letter-spacing 等值：
   居中排版时字距会在末字右侧多留一格，不补就整体偏左半格 */
.auth-kicker {
  padding-left: 0.36em;
  font-size: 20rpx;
  letter-spacing: 0.36em;
  color: rgba(226, 240, 222, 0.45);
}
.auth-brand {
  margin-top: 30rpx;
  padding-left: 0.16em;
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  line-height: 1.15;
  color: #F4F8EF;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.25);
}
.auth-slogan {
  margin-top: 32rpx;
  padding-left: 0.08em;
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: rgba(226, 240, 222, 0.62);
}

/* ---------------- 上浮面板 ---------------- */
.auth-panel {
  position: relative;
  z-index: 2;
  margin-top: -84rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #F8F7F2;
  border-radius: 44rpx 44rpx 0 0;
  padding: 48rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -24rpx 64rpx -26rpx rgba(11, 31, 22, 0.5);
}

.panel-title {
  font-size: 40rpx;
  line-height: 1.45;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ink);
}
.panel-title.sm { font-size: 34rpx; }
.panel-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-light);
}
.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.back-link {
  font-size: 24rpx;
  color: var(--green);
  letter-spacing: 0.02em;
}

/* ---------------- 登录 ---------------- */
.btn-wx {
  margin-top: 56rpx;
  height: 100rpx;
}
.btn-wx-ic {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  margin-right: 16rpx;
}
.legal {
  margin-top: 30rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.7;
  color: #9AA69C;
  letter-spacing: 0.02em;
}

/* ---------------- 头像与昵称 ----------------
   头像只能用 open-type="chooseAvatar" 的 button 选，所以这里要把它拆成「圆形壳」：
   button 自带的边框、内边距、居中全都要清掉，否则会顶出一个方角套圆角 */
.profile-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--border);
  border-radius: 50%;
  background: var(--green-mist);
  box-shadow: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 120rpx;
  height: 120rpx;
}
.avatar-empty {
  font-size: 40rpx;
  line-height: 1;
  color: var(--green);
  opacity: 0.5;
}
.profile-hint {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}
.profile-hint-t {
  font-size: 26rpx;
  color: var(--ink);
  margin-bottom: 6rpx;
}
.skip-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
}

/* 登录页下半部分：说明产品在做什么，同时把版面填满 */
.auth-why {
  margin-top: auto;
  padding-top: 34rpx;
  border-top: 1rpx solid var(--line);
}
.why-item {
  display: flex;
  align-items: center;
  padding: 13rpx 0;
}
.why-ic {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  margin-right: 16rpx;
  opacity: 0.85;
}
.why-tx {
  font-size: 23rpx;
  color: #7C8B81;
  line-height: 1.55;
}
.why-b {
  color: var(--ink);
  font-weight: 600;
  margin-right: 10rpx;
}

/* ---------------- 身份卡 ----------------
   三种身份各占一个色相：整块底色从左到右渐变 + 图标底色 + 名称颜色。
   渐变取角色色压到低透明度、终点化进白底，所以整张卡都是这个色相，
   但白底不会被染色 —— 右侧要留给「›」和大段说明文字，压色会读不清。
   这是设计系统「绿色只有四级」的唯一显式例外（角色色，见 AGENTS.md），
   只在身份选择语境里使用，其他页面不要借用这三个色。 */
.role-card {
  --role: var(--green);
  --role-ink: var(--role);      /* 文字用的加深色：底色压深后，标题要用比色相更深一档的墨色才压得住 */
  --role-soft: var(--green-mist);
  --role-line: rgba(23, 96, 58, 0.08);
  --role-wash: rgba(23, 96, 58, 0.34);   /* 渐变起点：左端最浓的一档角色色 */
  display: flex;
  align-items: center;
  background:
    linear-gradient(90deg, var(--role-wash) 0%, transparent 100%),
    #FFFFFF;
  border-radius: 30rpx;
  padding: 30rpx 28rpx;
  margin-top: 20rpx;
  border: 1rpx solid var(--role-line);
  box-shadow:
    0 2rpx 6rpx rgba(23, 33, 27, 0.03),
    0 16rpx 34rpx -22rpx rgba(23, 33, 27, 0.2);
}
/* 农户 · 绿（田间） */
.role-farmer {
  --role: #17603A;
  --role-ink: #0F4A2C;
  --role-soft: #E9F2EB;
  --role-line: rgba(23, 96, 58, 0.10);
  --role-wash: rgba(23, 96, 58, 0.34);
}
/* 消费者 · 蓝（餐桌） */
.role-consumer {
  --role: #2D5DA8;
  --role-ink: #1F4A8C;
  --role-soft: #EAEFF8;
  --role-line: rgba(45, 93, 168, 0.10);
  --role-wash: rgba(45, 93, 168, 0.32);
}
/* 采购商 · 金（市场）：色条用 #B4802F，文字压到深金才够对比度 */
.role-buyer {
  --role: #B4802F;
  --role-ink: #6F4A0F;
  --role-soft: #FAF1DF;
  --role-line: rgba(180, 128, 47, 0.16);
  --role-wash: rgba(180, 128, 47, 0.38);
}
.role-hover {
  transform: scale(0.982);
  opacity: 0.94;
}
.role-ic-wrap {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 24rpx;
  background: var(--role-soft);
  border: 1rpx solid var(--role-line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.role-ic {
  width: 46rpx;
  height: 46rpx;
}
.role-info { flex: 1; min-width: 0; }
.role-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--role-ink);
  letter-spacing: 0.02em;
}
.role-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  /* 底色压深后 --text-light 会被吃掉，说明字跟着提一档 */
  color: var(--text);
}
.role-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--role-ink);
  opacity: 0.55;
  margin-left: 12rpx;
}
.pick-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 21rpx;
  color: #B0B9B1;
  letter-spacing: 0.04em;
}

/* ---------------- 账号列表 ---------------- */
.farmer-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(23, 33, 27, 0.05);
  box-shadow: 0 2rpx 6rpx rgba(23, 33, 27, 0.02), 0 14rpx 30rpx -24rpx rgba(23, 33, 27, 0.22);
}
.f-info { flex: 1; min-width: 0; }
.f-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.reg-toggle {
  margin-top: 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--green);
  letter-spacing: 0.04em;
}

