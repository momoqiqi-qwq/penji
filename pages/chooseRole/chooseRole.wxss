/* pages/chooseRole/chooseRole.wxss —— 进入界面：深色头图 + 白卡上浮 */
.auth {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* ---------------- 头图 ---------------- */
.auth-hero {
  position: relative;
  overflow: hidden;
  padding: 88rpx 44rpx 148rpx;
  background:
    radial-gradient(120% 80% at 82% -18%, rgba(53, 160, 106, 0.5) 0%, rgba(53, 160, 106, 0) 62%),
    linear-gradient(168deg, #0A2318 0%, #0E3524 58%, #0A2819 100%);
}
/* 田垄斜线：低透明度，只做质感 */
.auth-hero::after {
  content: "";
  position: absolute;
  left: -14%;
  right: -14%;
  bottom: -34%;
  height: 82%;
  background: repeating-linear-gradient(
    170deg,
    rgba(207, 235, 200, 0.1) 0,
    rgba(207, 235, 200, 0.1) 1rpx,
    transparent 1rpx,
    transparent 34rpx
  );
  transform: rotate(-5deg);
  pointer-events: none;
}
.auth-kicker {
  font-size: 20rpx;
  letter-spacing: 0.36em;
  color: rgba(226, 240, 222, 0.45);
}
.auth-brand {
  margin-top: 26rpx;
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  line-height: 1.15;
  color: #F4F8EF;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.25);
}
.auth-slogan {
  margin-top: 22rpx;
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: rgba(226, 240, 222, 0.62);
}

/* ---------------- 上浮面板 ---------------- */
.auth-panel {
  position: relative;
  z-index: 2;
  margin-top: -84rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #F8F7F2;
  border-radius: 44rpx 44rpx 0 0;
  padding: 48rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -24rpx 64rpx -26rpx rgba(11, 31, 22, 0.5);
}

.panel-title {
  font-size: 40rpx;
  line-height: 1.45;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ink);
}
.panel-title.sm { font-size: 34rpx; }
.panel-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-light);
}
.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.back-link {
  font-size: 24rpx;
  color: var(--green);
  letter-spacing: 0.02em;
}

/* ---------------- 登录 ---------------- */
.btn-wx {
  margin-top: 56rpx;
  height: 100rpx;
}
.btn-wx-ic {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  margin-right: 16rpx;
}
.legal {
  margin-top: 30rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.7;
  color: #9AA69C;
  letter-spacing: 0.02em;
}

/* 登录页下半部分：说明产品在做什么，同时把版面填满 */
.auth-why {
  margin-top: auto;
  padding-top: 34rpx;
  border-top: 1rpx solid var(--line);
}
.why-item {
  display: flex;
  align-items: center;
  padding: 13rpx 0;
}
.why-ic {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  margin-right: 16rpx;
  opacity: 0.85;
}
.why-tx {
  font-size: 23rpx;
  color: #7C8B81;
  line-height: 1.55;
}
.why-b {
  color: var(--ink);
  font-weight: 600;
  margin-right: 10rpx;
}

/* ---------------- 身份卡 ----------------
   三种身份各占一个色相：左侧色条 + 图标底色 + 名称颜色。
   这是设计系统「绿色只有四级」的唯一显式例外（角色色，见 AGENTS.md），
   只在身份选择语境里使用，其他页面不要借用这三个色。 */
.role-card {
  --role: var(--green);
  --role-soft: var(--green-mist);
  --role-line: rgba(23, 96, 58, 0.08);
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 30rpx 28rpx;
  margin-top: 20rpx;
  border: 1rpx solid var(--role-line);
  box-shadow:
    inset 6rpx 0 0 var(--role),
    0 2rpx 6rpx rgba(23, 33, 27, 0.03),
    0 16rpx 34rpx -22rpx rgba(23, 33, 27, 0.2);
}
/* 农户 · 绿（田间） */
.role-farmer {
  --role: #17603A;
  --role-soft: #E9F2EB;
  --role-line: rgba(23, 96, 58, 0.10);
}
/* 消费者 · 蓝（餐桌） */
.role-consumer {
  --role: #2D5DA8;
  --role-soft: #EAEFF8;
  --role-line: rgba(45, 93, 168, 0.10);
}
/* 采购商 · 金（市场） */
.role-buyer {
  --role: #B4802F;
  --role-soft: #FAF1DF;
  --role-line: rgba(180, 128, 47, 0.14);
}
.role-hover {
  transform: scale(0.982);
  opacity: 0.94;
}
.role-ic-wrap {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 24rpx;
  background: var(--role-soft);
  border: 1rpx solid var(--role-line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.role-ic {
  width: 46rpx;
  height: 46rpx;
}
.role-info { flex: 1; min-width: 0; }
.role-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--role);
  letter-spacing: 0.02em;
}
.role-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text-light);
}
.role-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--role);
  opacity: 0.45;
  margin-left: 12rpx;
}
.pick-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 21rpx;
  color: #B0B9B1;
  letter-spacing: 0.04em;
}

/* ---------------- 账号列表 ---------------- */
.farmer-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(23, 33, 27, 0.05);
  box-shadow: 0 2rpx 6rpx rgba(23, 33, 27, 0.02), 0 14rpx 30rpx -24rpx rgba(23, 33, 27, 0.22);
}
.f-info { flex: 1; min-width: 0; }
.f-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.reg-toggle {
  margin-top: 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--green);
  letter-spacing: 0.04em;
}
