/* pages/addRecord/addRecord.wxss —— 农事记录：克制的档案式表单
   规则：白卡 + 双层阴影，行与行之间只用 26rpx 留白，不用灰线切内容块 */

.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 身份徽标带：浅绿圆角底，把 🌾 与身份文字收在一条带子里 */
.role-bar {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
  background: var(--green-mist);
  border-radius: var(--r-md);
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
  letter-spacing: 0.02em;
}

/* ---------------------------- 表单 ---------------------------- */
/* 表单行：只靠留白分隔，整块卡片保持干净 */
.field { margin-bottom: 26rpx; }
.field:last-child { margin-bottom: 0; }

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.5;
  letter-spacing: 0.02em;
}

/* 选择器做成和输入框同款的框，视觉上整齐一格 */
.picker {
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--green-mist);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}
.picker.placeholder { color: var(--text-light); }

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--green-mist);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  background: var(--green-mist);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 聚焦态：边框转绿、底色转白，只做这一处强调 */
.input:focus,
.textarea:focus {
  background: #FFFFFF;
  border-color: rgba(23, 96, 58, 0.35);
}

/* 占位符比正文再浅一档 */
.input-placeholder { color: var(--text-light); }

/* 说明文字：21rpx 暖灰，和 label 拉开层次 */
.tip {
  margin: 2rpx 4rpx 0;
  color: var(--text-light);
  font-size: 21rpx;
  line-height: 1.75;
  letter-spacing: 0.01em;
}
