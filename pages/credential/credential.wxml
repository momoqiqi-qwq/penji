<!-- pages/credential/credential.wxml -->
<!-- 被授权方看到的只有这一页：票面 + 授权维度的快照明细 + 明确写着「不包含什么」 -->
<view class="page" wx:if="{{cred}}">
  <view class="cert">
    <view class="between">
      <text class="cert-kicker">农户信用凭证</text>
      <text class="tag {{statusCls}}">{{statusText}}</text>
    </view>
    <view class="cert-name">{{cred.farmerName}}<text class="cert-village"> · {{cred.village}}</text></view>
    <view class="cert-score-row">
      <text class="cert-score">{{cred.snapshot.score}}</text>
      <view class="cert-score-side">
        <text class="cert-grade">{{cred.snapshot.gradeText}}</text>
      </view>
    </view>
    <view class="cert-rule"></view>
    <view class="between cert-meta">
      <text>授权给 {{cred.audience}}</text>
      <text>{{cred.expireAt}} 到期</text>
    </view>
    <view class="cert-note" wx:if="{{cred.note}}">用途：{{cred.note}}</view>
  </view>

  <view class="container">
    <view class="cert-alert" wx:if="{{status === 'revoked'}}">农户已收回这份授权。下面的内容只作留档，不能再作为评价依据。</view>
    <view class="cert-alert" wx:elif="{{status === 'expired'}}">这份凭证已过有效期，内容只作留档；要继续使用请让农户重新开具。</view>

    <view class="section-title">授权范围内的评价</view>
    <view class="card">
      <view class="muted cert-basis">评价依据：{{cred.snapshot.basis}}</view>

      <view class="cert-dim" wx:for="{{dims}}" wx:key="key" wx:for-item="dim">
        <view class="between">
          <text class="strong">{{dim.name}}</text>
          <text class="cert-dim-score">{{dim.score}} / {{dim.max}} 分</text>
        </view>
        <view class="bar-track"><view class="bar-fill" style="width:{{dim.pct}}%"></view></view>
        <view class="cert-item" wx:for="{{dim.items}}" wx:key="name" wx:for-item="it">
          <view class="between">
            <text>{{it.name}}</text>
            <text class="cert-item-score">{{it.score}}/{{it.max}}</text>
          </view>
          <view class="muted cert-item-note" wx:if="{{it.note}}">{{it.note}}</view>
        </view>
      </view>

      <view class="empty" wx:if="{{!dims.length}}">这份凭证没有附带可展示的维度明细</view>
    </view>

    <view class="section-title">这份凭证不包含</view>
    <view class="card">
      <view class="muted cert-gap">· 农户没有勾选授权的评价维度</view>
      <view class="muted cert-gap">· 原始农事记录、地块位置、联系方式、家庭信息</view>
      <view class="muted cert-gap">· 签发之后的任何变化——凭证是那一刻的快照，涨分跌分都不回填</view>
      <view class="muted cert-gap">· 农户发给其他机构的授权：每家只能看到自己那一份</view>
    </view>

    <view class="muted cert-id">凭证号 {{cred.credentialId}} · 签发于 {{cred.createdAt}}</view>
    <view class="muted cert-id cert-demo">演示版说明：凭证存在本机数据里，换一台手机打不开同一份；接上云开发后才是真正的跨端核验。</view>
  </view>
</view>

<view class="page" wx:else>
  <view class="empty">{{statusText}}</view>
</view>
