/* pages/credential/credential.wxss */
/* 票面用墨绿实底：这一页是「对外出具的凭证」，不是普通业务卡片 */

.cert {
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: var(--ink);
  box-shadow: var(--sh-2);
}

.cert-kicker {
  font-size: 22rpx;
  color: rgba(246, 250, 241, 0.62);
  letter-spacing: 2rpx;
}

.cert-name {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #F6FAF1;
}

.cert-village {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(246, 250, 241, 0.62);
}

.cert-score-row {
  display: flex;
  align-items: flex-end;
  margin-top: 20rpx;
}

.cert-score {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  color: #F6FAF1;
  font-variant-numeric: tabular-nums;
}

.cert-score-side {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  padding-bottom: 4rpx;
}

.cert-grade {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lime);
}

.cert-rule {
  height: 1rpx;
  margin: 28rpx 0 20rpx;
  background: rgba(246, 250, 241, 0.16);
}

.cert-meta {
  font-size: 22rpx;
  color: rgba(246, 250, 241, 0.72);
}

.cert-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(246, 250, 241, 0.72);
}

/* 失效状态下先把话说清楚，别让人对着旧数字做决定 */
.cert-alert {
  margin: 24rpx 0 0;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: rgba(180, 128, 47, 0.1);
  border-left: 6rpx solid var(--gold);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
}

.cert-basis {
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--text-light);
  margin-bottom: 24rpx;
}

.cert-dim {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.cert-dim:last-of-type {
  border-bottom: none;
  padding-bottom: 0;
}

.cert-dim > .between {
  align-items: baseline;
  margin-bottom: 12rpx;
}

.cert-dim-score {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.bar-track {
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--green-mist);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #2E9A62 0%, #17603A 100%);
}

.cert-item {
  margin-top: 16rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid rgba(23, 96, 58, 0.14);
}

.cert-item > .between {
  align-items: baseline;
}

.cert-item > .between text {
  font-size: 24rpx;
  color: var(--text-2);
}

.cert-item-score {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.cert-item-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-light);
}

.cert-gap {
  font-size: 22rpx;
  line-height: 1.9;
  color: var(--text-light);
}

.cert-id {
  margin: 28rpx 0 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-light);
  font-variant-numeric: tabular-nums;
}

/* 演示边界必须写在脸上：这一页会被截图出去，别让人以为已经跨端核验过了 */
.cert-demo {
  margin: -24rpx 0 40rpx;
  padding: 0 24rpx;
  line-height: 1.7;
}
