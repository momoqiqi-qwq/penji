<!-- pages/buyer/buyer.wxml 采购商工作台 -->
<view class="page">
  <view class="buyer-head">
    <image class="bh-bg" src="/assets/images/buyer-workbench.jpg" mode="aspectFill" />
    <view class="bh-mask"></view>
    <view class="bh-kicker">SOURCE · 采购与核验</view>
    <view class="bh-row">
      <view class="bh-avatar">采</view>
      <view class="bh-info">
        <view class="bh-name">{{buyer.name}}</view>
        <view class="bh-sub">{{buyer.org}}</view>
      </view>
      <view class="bh-switch" bindtap="switchRole">切换身份</view>
    </view>
  </view>

  <view class="container">
    <!-- tab 切换 -->
    <view class="tabs">
      <view class="tab {{tab==='plots' ? 'on' : ''}}" data-tab="plots" bindtap="switchTab">主推地块</view>
      <view class="tab {{tab==='receipts' ? 'on' : ''}}" data-tab="receipts" bindtap="switchTab">
        进货验收<text class="tab-badge" wx:if="{{receiptSummary.pending}}">{{receiptSummary.pending}}</text>
      </view>
      <view class="tab {{tab==='batches' ? 'on' : ''}}" data-tab="batches" bindtap="switchTab">批次核验</view>
      <view class="tab {{tab==='standards' ? 'on' : ''}}" data-tab="standards" bindtap="switchTab">食品标准库</view>
    </view>

    <!-- ============ 进货验收：限期接受确认 / 逾期补录 / 操作时限 ============ -->
    <block wx:if="{{tab==='receipts'}}">
      <view class="rc-head">
        <view class="rc-head-title">进货验收</view>
        <view class="rc-head-sub">{{receiptLimitText}}</view>
      </view>

      <view class="rc-summary">
        <view class="rc-sum-item">
          <text class="rc-sum-num">{{receiptSummary.pending}}</text>
          <text class="rc-sum-label">待确认</text>
        </view>
        <view class="rc-sum-item">
          <text class="rc-sum-num warn">{{receiptSummary.warn}}</text>
          <text class="rc-sum-label">即将超期</text>
        </view>
        <view class="rc-sum-item">
          <text class="rc-sum-num over">{{receiptSummary.overdue}}</text>
          <text class="rc-sum-label">已逾期</text>
        </view>
        <view class="rc-sum-item">
          <text class="rc-sum-num">{{receiptSummary.done}}</text>
          <text class="rc-sum-label">已处理</text>
        </view>
      </view>

      <view class="mp-empty" wx:if="{{!receipts.length}}">还没有进货单。到「批次核验」对已采收的批次登记进货，登记后开始计算 {{limitHours}} 小时确认时限。</view>

      <view class="rc-card {{item.phase}}" wx:for="{{receipts}}" wx:key="receiptId">
        <view class="rc-top">
          <view class="rc-name">{{item.productName}}</view>
          <text class="tag {{item.statusCls}}">{{item.phaseText}}</text>
        </view>
        <view class="rc-code">
          <text>{{item.receiptId}} · {{item.batchId}}</text>
          <text class="tag tag-gray rc-demo" wx:if="{{item.isDemo}}">演示样例</text>
        </view>
        <view class="rc-line">{{item.farmerName}} · 进货 {{item.receivedText}}{{item.qty ? ' · ' + item.qty + ' ' + item.unit : ''}}</view>
        <view class="rc-line">截止确认 {{item.deadlineText}}</view>

        <view class="rc-timer" wx:if="{{item.status === 'pending'}}">
          <view class="rc-timer-text {{item.phase}}">{{item.remainText}}</view>
          <view class="rc-bar">
            <view class="rc-bar-in {{item.phase}}" style="width:{{item.progress}}%"></view>
          </view>
        </view>
        <view class="rc-late" wx:if="{{item.lateText}}">{{item.lateText}}</view>

        <view class="rc-done" wx:if="{{item.status !== 'pending'}}">
          <text>验收结论：{{item.conclusion}}</text>
          <text wx:if="{{item.note}}"> · 备注：{{item.note}}</text>
          <text wx:if="{{item.lateReason}}"> · 超期原因：{{item.lateReason}}</text>
        </view>

        <view class="rc-actions" wx:if="{{item.status === 'pending'}}">
          <view class="rc-btn {{item.phase === 'overdue' ? 'warn' : ''}}" data-receipt="{{item.receiptId}}" bindtap="onOpenConfirm">
            {{item.phase === 'overdue' ? '逾期补录' : '接受确认'}}
          </view>
        </view>

        <!-- 内联确认表单：超期时多一栏必填原因 -->
        <view class="rc-form" wx:if="{{formReceiptId === item.receiptId}}">
          <view class="rc-form-tip {{item.phase === 'overdue' ? 'warn' : ''}}">
            {{item.phase === 'overdue' ? '已超过 ' + limitHours + ' 小时时限，本次只能「逾期补录」；超期时长与原因会随单留痕。' : '在时限内确认接受；提交后不可再修改。'}}
          </view>
          <view class="rc-form-label">验收结论</view>
          <view class="rc-chips">
            <view class="rc-chip {{formConclusion === c ? 'on' : ''}}" wx:for="{{conclusions}}" wx:for-item="c" wx:key="*this" data-value="{{c}}" bindtap="onReceiptConclusion">{{c}}</view>
          </view>
          <view class="rc-form-label">备注（可选）</view>
          <textarea class="rc-textarea" placeholder="如到货数量、外观品相、随货单据等" value="{{formNote}}" bindinput="onReceiptNote" maxlength="120" auto-height />
          <block wx:if="{{item.phase === 'overdue'}}">
            <view class="rc-form-label">超期原因（必填）</view>
            <textarea class="rc-textarea" placeholder="如出差在外、等待第三方复检结果等" value="{{formLateReason}}" bindinput="onReceiptLateReason" maxlength="120" auto-height />
          </block>
          <view class="rc-form-btns">
            <view class="rc-btn ghost" bindtap="cancelConfirm">取消</view>
            <view class="rc-btn" bindtap="submitConfirm">{{item.phase === 'overdue' ? '提交补录' : '确认接受'}}</view>
          </view>
        </view>
      </view>
    </block>

    <!-- ============ 主推农地块（临近成熟自动上浮） ============ -->
    <block wx:if="{{tab==='plots'}}">
      <view class="mp-head">
        <view class="mp-head-title">主推农地块</view>
        <view class="mp-head-sub">按距成熟天数实时排序，越临近成熟越靠前；标黄地块建议优先跟进采购。</view>
      </view>
      <view class="mp-summary">
        <view class="mp-sum-item">
          <text class="mp-sum-num">{{mainPlots.length}}</text>
          <text class="mp-sum-label">在册地块</text>
        </view>
        <view class="mp-sum-item">
          <text class="mp-sum-num near">{{nearCount}}</text>
          <text class="mp-sum-label">即将成熟</text>
        </view>
      </view>

      <view class="mp-empty" wx:if="{{!mainPlots.length}}">暂无地块数据</view>

      <view class="mp-card {{item.nearMature ? 'near' : ''}} {{!item.active ? 'idle' : ''}}"
            wx:for="{{mainPlots}}" wx:key="plotId">
        <view class="mp-badge" wx:if="{{item.nearMature}}">● 即将成熟 · 建议跟进</view>

        <view class="mp-top">
          <view class="mp-plot">
            <view class="mp-name">{{item.name}}</view>
            <view class="mp-loc">{{item.village}} · {{item.area}}亩 · {{item.soilType}}</view>
          </view>
          <view class="mp-days {{item.nearMature ? 'hot' : ''}}">
            <text class="mp-days-num">{{item.daysText}}</text>
            <text class="mp-days-sub" wx:if="{{item.active}}">成熟倒计时</text>
          </view>
        </view>

        <block wx:if="{{item.active}}">
          <view class="mp-crop">
            <text class="mp-crop-name">{{item.cropName}}</text>
            <text class="mp-stage">{{item.stage}}</text>
            <text class="mp-cycle">全周期 {{item.cycleDays}} 天</text>
          </view>
          <view class="mp-progress">
            <view class="mp-progress-top">
              <text>生长进度</text>
              <text>{{item.progress}}%</text>
            </view>
            <view class="mp-track">
              <view class="mp-fill {{item.nearMature ? 'hot' : ''}}" style="width:{{item.progress}}%"></view>
            </view>
            <view class="mp-date-row">
              <text>播种 {{item.plantDate}}</text>
              <text>预计成熟 {{item.expectedHarvest}}</text>
            </view>
          </view>
        </block>
        <view class="mp-idle" wx:else>当前休耕，暂无在种作物</view>

        <view class="mp-foot">
          <view class="mp-farmer">农户 {{item.farmerName}}<text wx:if="{{item.farmerStar}}"> · ★{{item.farmerStar}}</text></view>
          <block wx:if="{{item.active}}">
            <view class="mp-btn" wx:if="{{!item.preorder}}" data-batch="{{item.batchId}}" catchtap="onPreorder">预订购</view>
            <view class="mp-tag-mine" wx:elif="{{item.preorderMine}}" data-preorder="{{item.preorder.preorderId}}" catchtap="onCancelPreorder">已预订 · 取消</view>
            <view class="mp-tag-locked" wx:else>已被 {{item.preorder.buyerName}} 预订</view>
          </block>
        </view>
      </view>
    </block>

    <!-- ============ 批次核验 ============ -->
    <block wx:if="{{tab==='batches'}}">
      <!-- 风险预警（可折叠，默认收起，有风险时标题带红点） -->
      <view class="section-title between" catchtap="toggleRisk" wx:if="{{riskCount}}">
        <text>生产风险预警 · {{riskCount}}</text>
        <view class="fold-arrow {{riskExpanded ? 'up' : ''}}">›</view>
      </view>
      <view class="risk-box" wx:if="{{riskExpanded && riskCount}}">
        <view class="risk-item" wx:for="{{risks}}" wx:key="batchId">
          <view class="risk-name">{{item.productName}}（{{item.batchId}}）· 风险{{item.riskLevel}}</view>
          <view class="risk-detail" wx:for="{{item.risks}}" wx:for-item="rr" wx:key="*this">{{rr}}</view>
          <view class="risk-go" data-id="{{item.batchId}}" bindtap="goInspect">去核验 ›</view>
        </view>
      </view>

      <!-- 产品批次（可折叠） -->
      <view class="section-title between" catchtap="toggleBatches">
        <text>产品批次（{{batches.length}}）</text>
        <view class="fold-arrow {{batchesExpanded ? 'up' : ''}}">›</view>
      </view>
      <block wx:if="{{batchesExpanded}}">
        <view class="batch-card" wx:for="{{batches}}" wx:key="batchId" data-id="{{item.batchId}}" bindtap="goInspect" hover-class="card-hover">
          <view class="bc-top">
            <view class="bc-name">{{item.productName}}</view>
            <text class="tag {{item.opiCls}}" wx:if="{{item.opiScore !== null}}">OPI {{item.opiScore}}·{{item.opiLevel}}</text>
          </view>
          <view class="bc-code">{{item.batchId}}</view>
          <view class="bc-line">{{item.farmerName}}{{item.village ? ' · ' + item.village : ''}} · {{item.status}}{{item.harvestDate ? '（采收 ' + item.harvestDate + '）' : ''}}</view>
          <view class="bc-tags">
            <text class="tag {{item.orgCls}}">有机·{{item.orgStatus}}</text>
            <text class="tag {{item.testDone ? 'tag-green' : 'tag-gray'}}">{{item.testStatus}}</text>
            <text class="tag {{item.compRate >= 80 ? 'tag-green' : (item.compRate >= 60 ? 'tag-gold' : 'tag-warn')}}">档案 {{item.compRate}}%</text>
            <text class="tag {{item.riskLevel === '低' ? 'tag-green' : (item.riskLevel === '中' ? 'tag-gold' : 'tag-warn')}}">风险{{item.riskLevel}}</text>
          </view>

          <!-- 已采收的批次才能登记进货；同一批次同一采购商只登记一次 -->
          <view class="bc-foot" wx:if="{{item.hasReceipt}}">
            <text class="tag tag-green">已登记进货</text>
          </view>
          <view class="bc-foot" wx:elif="{{item.harvested}}">
            <view class="mp-btn" data-batch="{{item.batchId}}" catchtap="onOpenRegister">登记进货</view>
          </view>

          <view class="reg-form" wx:if="{{registerBatchId === item.batchId}}" catchtap="stopTap">
            <view class="reg-row">
              <text class="reg-label">进货日期</text>
              <picker mode="date" value="{{regDate}}" bindchange="onRegDate">
                <view class="reg-picker">{{regDate}}</view>
              </picker>
            </view>
            <view class="reg-row">
              <text class="reg-label">进货数量</text>
              <input class="reg-input" type="digit" placeholder="kg，可留空" value="{{regQty}}" bindinput="onRegQty" />
            </view>
            <view class="reg-tip">登记后 {{limitHours}} 小时内须完成接受确认，超期只能补录并留痕。</view>
            <view class="reg-btns">
              <view class="rc-btn ghost" catchtap="closeRegister">取消</view>
              <view class="rc-btn" catchtap="submitRegister">确认登记</view>
            </view>
          </view>
        </view>
      </block>
    </block>

    <!-- ============ 食品标准库（可折叠） ============ -->
    <block wx:if="{{tab==='standards'}}">
      <view class="section-title between" catchtap="toggleStandards">
        <text>食品标准库（{{standards.length}}）</text>
        <view class="fold-arrow {{standardsExpanded ? 'up' : ''}}">›</view>
      </view>
      <view wx:if="{{standardsExpanded}}">
        <view class="demo-banner">【演示标准参考数据】以下为本地演示标准样例，非官方实时标准数据库，正式检测请以最新发布的国家标准文本为准。</view>
        <view class="std-card" wx:for="{{standards}}" wx:key="stdId">
          <view class="std-code">{{item.code}}</view>
          <view class="std-name">{{item.name}}</view>
          <view class="std-scope">{{item.scope}}</view>
          <view class="std-items">
            <view class="std-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="name">
              <text>{{it.name}}</text>
              <text class="std-limit">限量 {{it.limit}} {{it.unit === '-' ? '' : it.unit}}</text>
            </view>
          </view>
          <text class="tag tag-gray">演示参考</text>
        </view>
      </view>
    </block>
  </view>
</view>
