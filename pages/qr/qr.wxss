/* pages/qr/qr.wxss —— 溯源码：一张干净的档案卡 + 印刷级二维码 */
.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 档案卡：纯白 + 双层阴影，靠圆角和留白撑气质 */
.qr-card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-1);
  border: 1rpx solid rgba(23, 33, 27, 0.03);
}

.qr-title {
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.02em;
}

/* 二维码外层：flex 强制水平居中，避免 canvas 替换元素 margin:auto 偶发失效 */
.qr-canvas-wrap {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

/* 二维码：只加一圈发丝线做印刷边框，不改画布尺寸与绘制区域 */
.qr-canvas {
  width: 560rpx;
  height: 560rpx;
  display: block;
  background: #FFFFFF;
  border-radius: var(--r-md);
  box-shadow:
    0 0 0 1rpx var(--border),
    0 2rpx 6rpx rgba(23, 33, 27, 0.03),
    0 18rpx 40rpx -26rpx rgba(23, 33, 27, 0.22);
}

/* 溯源码做成浅绿小牌，数字用等宽数位 */
.qr-code {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 12rpx 26rpx;
  background: var(--green-mist);
  border-radius: var(--r-sm);
  color: var(--green);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: 0.06em;
  font-variant-numeric: tabular-nums;
}

/* 说明条：浅绿圆角底 + 左侧一道主绿短线，替代原来的灰色小字块 */
.qr-tip {
  position: relative;
  margin-top: 24rpx;
  padding: 22rpx 24rpx 22rpx 32rpx;
  background: var(--green-mist);
  border-radius: var(--r-md);
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.7;
  text-align: left;
  letter-spacing: 0.01em;
}
.qr-tip::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--green);
  opacity: 0.5;
}
