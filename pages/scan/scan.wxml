<!-- pages/scan/scan.wxml -->
<view class="page">
  <view class="scan-hero">
    <image class="scan-bg" src="/assets/images/scan-hero.jpg" mode="aspectFill" />
    <view class="scan-mask"></view>
    <view class="scan-kicker">TRACE · 溯源码</view>
    <view class="scan-title">扫码，看这块地的档案</view>
  </view>

  <view class="container">
    <view class="scan-entry">
      <view class="scan-badge" bindtap="doScan" hover-class="scan-badge-hover">
        <view class="scan-badge-ring"></view>
        <view class="scan-badge-core">
          <image class="scan-badge-ic" src="/assets/icons/scan-white.png" mode="aspectFit" />
        </view>
        <view class="scan-badge-tx">扫一扫</view>
      </view>
    </view>
    <button class="btn btn-outline btn-block mt-16" bindtap="mockScan">模拟扫码（演示用）</button>

    <!-- 农户：我的二维码 -->
    <block wx:if="{{isFarmer && myBatches.length}}">
      <view class="section-title mt-24">我的农产品二维码</view>
      <view class="card qr-card" wx:if="{{myBatches.length}}">
        <view class="recent-item" wx:for="{{myBatches}}" wx:key="batchId">
          <view class="between" bindtap="goBatch" data-id="{{item.batchId}}">
            <view class="recent-main">
              <view class="recent-prod">{{item.productName}}</view>
              <view class="muted mt-8">{{item.batchId}} · {{item.plotName}}</view>
            </view>
            <view class="tag tag-green">查看 ›</view>
          </view>
          <view class="row mt-8">
            <view class="qr-mini-btn" catchtap="goQr" data-id="{{item.batchId}}">打印二维码</view>
          </view>
        </view>
      </view>
    </block>

    <view class="section-title mt-24">输入溯源码</view>
    <view class="card code-card">
      <view class="code-deco" aria-hidden="true"></view>
      <input class="code-input" placeholder="如 B-001" value="{{code}}" bindinput="onInput" />
      <button class="btn btn-block mt-16" bindtap="traceInput">溯源</button>
    </view>

    <view class="section-title between" wx:if="{{recent.length}}" bindtap="toggleRecent">
      <text>最近查看</text>
      <view class="fold-arrow {{recentExpanded ? 'up' : ''}}">›</view>
    </view>
    <view class="card recent-card" wx:if="{{recent.length && recentExpanded}}">
      <view class="recent-item" wx:for="{{recent}}" wx:key="batchId" bindtap="goBatch" data-id="{{item.batchId}}">
        <view class="between">
          <view class="recent-main">
            <view class="recent-prod">{{item.productName}}</view>
            <view class="muted mt-8">{{item.batchId}} · {{item.plotName}}</view>
          </view>
          <view class="link-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="section-title between" bindtap="toggleBatches">
      <text>全部批次</text>
      <view class="fold-arrow {{batchesExpanded ? 'up' : ''}}">›</view>
    </view>
    <view class="card batch-card" wx:if="{{batchesExpanded && batches.length}}">
      <view class="recent-item" wx:for="{{batches}}" wx:key="batchId" bindtap="goBatch" data-id="{{item.batchId}}">
        <view class="between">
          <view class="recent-main">
            <view class="recent-prod">{{item.productName}}</view>
            <view class="muted mt-8">{{item.batchId}} · {{item.plotName}} · {{item.farmerName}}</view>
          </view>
          <view class="link-arrow">›</view>
        </view>
      </view>
    </view>
    <view class="empty" wx:elif="{{batchesExpanded}}">暂无批次</view>
  </view>
</view>
